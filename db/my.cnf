# =============================================================================
# MariaDB — configuration dédiée GLPI
# =============================================================================
[mysqld]
# Charset / collation : GLPI requiert utf8mb4
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# InnoDB : GLPI stocke tickets, historiques et pièces jointes -> buffers généreux
innodb_buffer_pool_size = 1G
innodb_log_file_size    = 256M
innodb_file_per_table   = 1
innodb_flush_method     = O_DIRECT

# Gros fichiers joints dans tickets : autoriser des payloads importants
max_allowed_packet = 64M

# Timeouts réseaux adaptés à des clients web lents
wait_timeout = 600
interactive_timeout = 600

# UTF-8 complet y compris emojis dans les tickets
init_connect = 'SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci'

[client]
default-character-set = utf8mb4
